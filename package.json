{
  "name": "explosives-precursors-and-poisons",
  "version": "1.0.0",
  "description": "Explosives Precursors and Poisons form",
  "main": "index.js",
  "engines": {
    "node": ">=24.22.1 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "[ -f .env ] && hof-build watch --env || hof-build watch",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test": "NODE_ENV=test yarn run test:lint && yarn run test:unit",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:headed": "bddgen && playwright test --headed",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:unit": "jest",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:UKHomeOffice/explosives-precursors-poisons.git"
  },
  "author": "HOF",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/explosives-precursors-poisons"
  },
  "homepage": "https://github.com/UKHomeOffice/explosives-precursors-poisons",
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "accessible-autocomplete": "^3.0.2",
    "bl": "^6.1.6",
    "busboy": "^1.6.0",
    "crypto-random-string": "^6.0.0",
    "form-data": "^4.0.6",
    "hof": "~24.5.0",
    "lodash": "^4.18.1",
    "notifications-node-client": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20.19.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-hof": "^1.3.4",
    "jest": "^30.5.1",
    "playwright-bdd": "^9.2.0"
  },
  "resolutions": {
    "qs": "^6.16.1",
    "source-map-js": "^1.2.2",
    "body-parser": "^2.4.0",
    "follow-redirects": "^1.16.1",
    "markdown-it": "^15.0.3"
  }
}
