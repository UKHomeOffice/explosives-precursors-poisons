{
  "verbose": true,
  "collectCoverage": true,
  "collectCoverageFrom": [
    "**/*.js",
    "!**/node_modules/**",
    "!**/coverage/**",
    "!config.js",
    "!**/public/js/*.js",
    "!apps/**/fields/*.js",
    "!apps/**/index.js",
    "!apps/**/sections/summary-data-sections.js",
    "!test/**/*.js",
    "!server.js",
    "!utilities/constants/**/*.js"
  ],
  "setupFiles": ["<rootDir>/jest.env.js"],
  "setupFilesAfterEnv": ["<rootDir>/test/jest.setup.js"]
}
